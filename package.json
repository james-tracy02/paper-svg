{
  "name": "paper-svg",
  "version": "0.4.3",
  "description": "Skeletal node-tree engine for rendering articulated SVG rigs with sprites.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "scripts"
  ],
  "main": "./dist/paper-svg.cjs",
  "module": "./dist/paper-svg.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/paper-svg.js",
      "require": "./dist/paper-svg.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo && tsc --noEmit -p test && tsc --noEmit -p bench",
    "dev": "vite build --watch",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "test": "vitest run --project unit",
    "test:snapshots": "vitest run --project browser",
    "profile": "node bench/profile.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "paper": "^0.12.18",
    "paperjs-offset": "^1.0.8",
    "svgpath": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "react": "^19.1.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.6",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^5.1.0"
  },
  "author": "lokkit",
  "homepage": "https://github.com/james-tracy02/paper-svg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/james-tracy02/paper-svg.git"
  },
  "bugs": {
    "url": "https://github.com/james-tracy02/paper-svg/issues"
  },
  "keywords": [
    "svg",
    "skeletal-animation",
    "rigging",
    "puppet",
    "sprites",
    "react"
  ]
}
