{
  "name": "paper-svg",
  "version": "0.1.0",
  "description": "Skeletal node-tree engine for rendering articulated SVG rigs with sprites.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/paper-svg.cjs",
  "module": "./dist/paper-svg.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/paper-svg.js",
      "require": "./dist/paper-svg.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "paper": "^0.12.18",
    "paperjs-offset": "^1.0.8",
    "svgpath": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "react": "^19.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.6",
    "vite-plugin-dts": "^4.5.3"
  }
}
